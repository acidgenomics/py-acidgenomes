# The global core.excludesFile ignores docs/ and reference/; these are sources.
!docs/
!docs/reference/
!docs/_themes/
!docs/_themes/**/*.html
docs/_build/
docs/reference/generated/

# The global core.excludesFile ignores *.gtf; these are hand-authored test fixtures.
!tests/fixtures/
!tests/fixtures/*.gtf

# Pins only this machine's dev-tool versions; not needed by consumers.
uv.lock
